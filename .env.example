# gpt-image-2 画像生成スキル 環境変数サンプル
# -----------------------------------------------------------------------------
# 使い方:
#   1. このファイルを `.env` という名前でコピーします（例: `cp .env.example .env`）。
#   2. 下記の値を自分の Azure リソースに合わせて設定します。
#   3. `.env` は秘密情報を含むため、絶対にコミット・共有しないでください。
#
# 読み込みの仕組み:
#   - スキル実行時、カレントディレクトリから上位へ `.env` を探索し、最初に
#     見つかったものを読み込みます（このプロジェクトフォルダ直下が想定）。
#   - すでに OS 側に設定済みの環境変数が優先され、`.env` は未設定分のみ補完します。
# -----------------------------------------------------------------------------

# 【必須】Azure OpenAI リソースのベース URL（デプロイ名やパスは含めない）
# 例: https://<your-resource-name>.openai.azure.com
#     https://<your-resource-name>.cognitiveservices.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com

# 【必須】gpt-image-2 をデプロイしたときに付けたデプロイ名
AZURE_OPENAI_DEPLOYMENT=gpt-image-2

# 【任意】API キー認証を使う場合のみ設定する。
#   - 設定しない場合は Entra ID（キーレス）認証を優先します（`az login` 済み等）。
#   - キーは Azure Key Vault 等で管理し、定期的にローテーションしてください。
AZURE_OPENAI_API_KEY=

# 【任意】使用する API バージョン（未設定時の既定: 2025-04-01-preview）
#   - gpt-image-2 には 2025-04-01-preview 以降が必要です。
#   - 古いバージョン（例: 2024-02-01）は gpt-image-2 に対応していません。
AZURE_OPENAI_API_VERSION=2025-04-01-preview


# -----------------------------------------------------------------------------
# 生成パラメータの既定値（すべて任意）
#   - 優先順位: CLI 引数 > ここで設定した値(.env) > スクリプト組み込み既定。
#   - つまり、よく使う設定をここに書いておけば、毎回 CLI 引数を渡す必要がありません。
#   - 不正な値は実行時にエラーになります（制約は SKILL.md / references を参照）。
# -----------------------------------------------------------------------------

# 解像度 WxH（組み込み既定: 1024x1024）。両辺16の倍数/長辺≤3840/比≤3:1/総画素 655,360〜8,294,400。
# - 例: 1024x1024, 1536x1024, 3840x1080
GPT_IMAGE_SIZE=1024x1024

# 【画像編集用】解像度 WxH または auto（組み込み既定: auto）。auto は入力画像に追従。
# - generate_image.py は GPT_IMAGE_SIZE、edit_image.py は GPT_IMAGE_EDIT_SIZE を参照します。
GPT_IMAGE_EDIT_SIZE=auto

# 画質: low / medium / high（組み込み既定: high）
GPT_IMAGE_QUALITY=high

# 出力形式: png / jpeg（組み込み既定: png）。WEBP は非対応。
GPT_IMAGE_FORMAT=png

# 背景: auto / transparent（組み込み既定: auto）。transparent は GPT_IMAGE_FORMAT=png が必須。
GPT_IMAGE_BACKGROUND=auto

# JPEG 圧縮 0-100（組み込み既定: 100）。GPT_IMAGE_FORMAT=jpeg のときのみ有効。
GPT_IMAGE_COMPRESSION=100

# 生成枚数 1-10（組み込み既定: 1）
GPT_IMAGE_N=1

# 保存先ディレクトリ（組み込み既定: ./images）。無ければ自動作成。
GPT_IMAGE_OUTPUT_DIR=./images

# 利用状況トラッキング用 ID（組み込み既定: なし）
GPT_IMAGE_USER=
