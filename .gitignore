# --- 秘密情報 ---------------------------------------------------------------
# .env は API キー等の秘密情報を含むため絶対にコミットしない。
.env
.env.*
# .env のバックアップ（例: .env_bk261107）も秘密情報を含むため除外する
.env_*
.env-*
!.env.example

# --- 生成物 -----------------------------------------------------------------
# スキルが生成した画像の既定保存先
images/
out/

# --- ブログ下書き -----------------------------------------------------------
# Qiita 記事と素材（リポジトリには含めない）
qiita_blog/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 仮想環境
.venv/
venv/
env/

# --- OS / エディタ ----------------------------------------------------------
.DS_Store
Thumbs.db
